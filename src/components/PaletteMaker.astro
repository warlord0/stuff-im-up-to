---
// Live palette generator: ported from the public/tools/colour-palette/
// prototype, restyled to use the site's own theme tokens instead of its
// own hardcoded light-only chrome. The generated preview keeps its own
// --bg/--text/--primary/etc custom properties, since that's the palette
// being judged, not the site's theme.
---
<div class="palette-maker not-prose">
  <div class="pm-controls">
    <label>Base colour <input type="color" id="pm-pick" value="#0d9488"></label>
    <input type="text" id="pm-hex" value="#0d9488" aria-label="Hex colour">
    <div class="pm-modes" id="pm-modes"></div>
    <button id="pm-copy" class="pm-btn">Copy CSS variables</button>
  </div>
  <div class="pm-swatches" id="pm-swatches"></div>
  <p class="pm-checks" id="pm-checks"></p>
  <div id="pm-ui" class="pm-ui">
    <nav><strong>Acme</strong><a href="#">Products</a><a href="#">Pricing</a><a href="#">Docs</a></nav>
    <section class="pm-hero">
      <h1>Build something people love</h1>
      <p>A short paragraph of body text so you can judge how readable the palette is at normal size.</p>
      <button class="pm-ui-btn p">Get started</button><button class="pm-ui-btn s">Learn more</button>
    </section>
    <section class="pm-cards">
      <div class="pm-card"><span class="pm-tag">New</span><h3>Fast</h3><p>Cards sit on the surface colour.</p></div>
      <div class="pm-card"><span class="pm-tag">Popular</span><h3>Simple</h3><p>Accent colour used for tags.</p></div>
      <div class="pm-card"><span class="pm-tag">Beta</span><h3>Flexible</h3><p>Text stays high contrast.</p></div>
    </section>
    <form onsubmit="return false"><input placeholder="you@example.com"><button class="pm-ui-btn a">Subscribe</button></form>
  </div>
  <h3>Saved palettes</h3>
  <form id="pm-saveForm" class="pm-saveform">
    <input id="pm-name" placeholder="Palette name" required>
    <button class="pm-btn">Save current</button>
  </form>
  <div id="pm-saved" class="pm-saved"></div>
</div>
<style is:global>
.palette-maker{font-family:var(--font-app);color:var(--foreground);display:grid;gap:1rem;margin:2rem 0}
.palette-maker h3{margin:.5rem 0 0}
.palette-maker .pm-controls{display:flex;flex-wrap:wrap;gap:1rem;align-items:center;padding:1rem;background:var(--muted);border:1px solid var(--border);border-radius:12px}
.palette-maker .pm-controls label{display:flex;align-items:center;gap:.5rem;font-size:.9rem;color:var(--muted-foreground)}
.palette-maker .pm-controls input[type=color]{width:42px;height:34px;padding:0;border:1px solid var(--border);border-radius:6px;background:none}
.palette-maker .pm-controls input[type=text]{width:100px;font:inherit;font-family:var(--font-code);padding:.4rem .5rem;border:1px solid var(--border);border-radius:6px;background:var(--background);color:var(--foreground)}
.palette-maker .pm-modes{display:flex;flex-wrap:wrap;gap:.35rem}
.palette-maker .pm-modes button,.palette-maker .pm-btn{font:inherit;padding:.4rem .9rem;border:1px solid var(--border);background:var(--background);color:var(--muted-foreground);border-radius:99px;cursor:pointer}
.palette-maker .pm-modes button[aria-pressed=true]{background:var(--accent);border-color:var(--accent);color:var(--accent-foreground)}
.palette-maker .pm-btn:hover,.palette-maker .pm-modes button:hover{border-color:var(--accent)}
.palette-maker .pm-swatches{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:.5rem}
.palette-maker .pm-swatches>div{border-radius:10px;padding:.75rem;min-height:64px;font-size:.8rem;border:1px solid var(--border);cursor:pointer}
.palette-maker .pm-swatches b{display:block;font-size:.85rem}
.palette-maker .pm-checks{font-size:.8rem;color:var(--muted-foreground);margin:0}
.palette-maker .pm-ui{border-radius:16px;overflow:hidden;border:1px solid var(--border);background:var(--bg);color:var(--text)}
.palette-maker .pm-ui :is(h1,h2,h3,h4,p,strong,a,ol,ul,figcaption,table,code){color:inherit;font-style:normal}
.palette-maker .pm-ui nav{display:flex;gap:20px;align-items:center;padding:14px 24px;background:var(--surface)}
.palette-maker .pm-ui nav strong{color:var(--primary);font-size:18px;margin-right:auto}
.palette-maker .pm-ui nav a{color:var(--text);text-decoration:none;opacity:.8}
.palette-maker .pm-hero{padding:48px 24px}
.palette-maker .pm-hero h1{margin:0 0 8px;font-size:32px;color:var(--text)}
.palette-maker .pm-hero p{margin:0 0 20px;opacity:.8;max-width:55ch}
.palette-maker .pm-ui-btn{font:inherit;padding:10px 20px;border-radius:8px;border:2px solid var(--primary);cursor:pointer;margin-right:8px}
.palette-maker .pm-ui-btn.p{background:var(--primary);color:var(--onPrimary)}
.palette-maker .pm-ui-btn.s{background:transparent;color:var(--primary)}
.palette-maker .pm-cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;padding:0 24px 24px}
.palette-maker .pm-card{background:var(--surface);border-radius:10px;padding:16px}
.palette-maker .pm-card h3{margin:0 0 6px}
.palette-maker .pm-tag{display:inline-block;background:var(--accent);color:var(--onAccent);font-size:12px;padding:2px 10px;border-radius:99px;margin-bottom:8px}
.palette-maker .pm-ui form{padding:0 24px 32px;display:flex;flex-wrap:wrap;gap:8px}
.palette-maker .pm-ui input{font:inherit;padding:10px;border-radius:8px;border:1px solid var(--primary);background:var(--surface);color:var(--text);flex:1;min-width:180px}
.palette-maker .pm-ui-btn.a{background:var(--accent);color:var(--onAccent);border-color:var(--accent)}
.palette-maker .pm-saveform{display:flex;gap:.5rem;margin:0}
.palette-maker .pm-saveform input{font:inherit;padding:.5rem;border:1px solid var(--border);border-radius:6px;background:var(--background);color:var(--foreground)}
.palette-maker .pm-saved{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:.5rem}
.palette-maker .pm-saved>div{cursor:pointer;background:var(--muted);border:1px solid var(--border);border-radius:8px;padding:.5rem}
.palette-maker .pm-saved .pm-strip{display:flex;height:28px;border-radius:4px;overflow:hidden;margin-bottom:6px}
.palette-maker .pm-saved .pm-row{display:flex;justify-content:space-between;gap:4px;font-size:.85rem;color:var(--foreground)}
.palette-maker .pm-saved .pm-row small{color:var(--muted-foreground)}
.palette-maker .pm-saved button{border:0;background:none;cursor:pointer;color:var(--muted-foreground)}
.palette-maker .pm-empty{color:var(--muted-foreground);grid-column:1/-1}
</style>
<script>
// ---- colour maths: hex <-> OKLCH (Björn Ottosson's OKLab) ----
const lin = (c: number) => (c <= .04045 ? c / 12.92 : ((c + .055) / 1.055) ** 2.4);
const gam = (c: number) => (c <= .0031308 ? 12.92 * c : 1.055 * c ** (1 / 2.4) - .055);
type Oklch = { L: number; C: number; h: number };
function hexToOklch(hex: string): Oklch {
  const [r, g, b] = [1, 3, 5].map(i => lin(parseInt(hex.slice(i, i + 2), 16) / 255));
  const l = Math.cbrt(.4122214708 * r + .5363325363 * g + .0514459929 * b);
  const m = Math.cbrt(.2119034982 * r + .6806995451 * g + .1073969566 * b);
  const s = Math.cbrt(.0883024619 * r + .2817188376 * g + .6299787005 * b);
  const L = .2104542553 * l + .793617785 * m - .0040720468 * s;
  const a = 1.9779984951 * l - 2.428592205 * m + .4505937099 * s;
  const bb = .0259040371 * l + .7827717662 * m - .808675766 * s;
  return { L, C: Math.hypot(a, bb), h: (Math.atan2(bb, a) * 180 / Math.PI + 360) % 360 };
}
function rgbOf({ L, C, h }: Oklch): [number, number, number] {
  const a = C * Math.cos((h * Math.PI) / 180), b = C * Math.sin((h * Math.PI) / 180);
  const l = (L + .3963377774 * a + .2158037573 * b) ** 3, m = (L - .1055613458 * a - .0638541728 * b) ** 3, s = (L - .0894841775 * a - 1.291485548 * b) ** 3;
  return [4.0767416621 * l - 3.3077115913 * m + .2309699292 * s, -1.2684380046 * l + 2.6097574011 * m - .3413193965 * s, -.0041960863 * l - .7034186147 * m + 1.707614701 * s];
}
function oklchToHex(c: Oklch): string {
  c = { ...c };
  while (rgbOf(c).some(v => v < -.001 || v > 1.001) && c.C > 0) c.C -= .005; // ponytail: clip-by-chroma gamut mapping, fine for UI colours
  return "#" + rgbOf(c).map(v => Math.round(Math.min(1, Math.max(0, gam(Math.min(1, Math.max(0, v))))) * 255).toString(16).padStart(2, "0")).join("");
}
const lum = (hex: string) => { const [r, g, b] = [1, 3, 5].map(i => lin(parseInt(hex.slice(i, i + 2), 16) / 255)); return .2126 * r + .7152 * g + .0722 * b; };
const contrast = (a: string, b: string) => { const [x, y] = [lum(a), lum(b)].sort((p, q) => q - p); return (x + .05) / (y + .05); };
const onColour = (bg: string) => (contrast(bg, "#ffffff") >= contrast(bg, "#111111") ? "#ffffff" : "#111111");

// ---- the recipes: each returns {role: oklch} from the base ----
const wrap = (h: number) => ((h % 360) + 360) % 360;
const recipes: Record<string, (b: Oklch) => Record<string, Oklch>> = {
  Calm: ({ L, C, h }) => ({
    primary: { L: Math.min(L, .5), C, h }, accent: { L: .62, C: .07, h: wrap(h + 35) },
    bg: { L: .97, C: .01, h }, surface: { L: .93, C: .02, h }, text: { L: .25, C: .03, h } }),
  Warm: ({ L, C, h }) => ({
    primary: { L: Math.min(L, .5), C, h }, accent: { L: .72, C: .12, h: 65 },
    bg: { L: .97, C: .02, h: 85 }, surface: { L: .93, C: .03, h: 80 }, text: { L: .25, C: .03, h } }),
  Bold: ({ L, C, h }) => ({
    primary: { L: Math.min(L, .5), C: Math.max(C, .2), h }, accent: { L: .68, C: .2, h: wrap(h + 180) },
    bg: { L: .98, C: .01, h }, surface: { L: 1, C: 0, h }, text: { L: .2, C: .02, h } }),
  Dark: ({ L, C, h }) => ({
    primary: { L: Math.max(L, .72), C: Math.min(C, .15), h }, accent: { L: .78, C: .12, h: wrap(h + 180) },
    bg: { L: .2, C: .03, h }, surface: { L: .26, C: .035, h }, text: { L: .93, C: .015, h } }),
  Pastel: ({ L, C, h }) => ({
    primary: { L: .7, C: Math.min(C, .1), h }, accent: { L: .85, C: .08, h: wrap(h + 40) },
    bg: { L: .98, C: .015, h }, surface: { L: .95, C: .03, h }, text: { L: .35, C: .04, h } }),
  Earthy: ({ L, C, h }) => ({
    primary: { L: Math.min(L, .5), C: Math.min(C, .1), h }, accent: { L: .62, C: .11, h: wrap(h > 90 && h < 160 ? 45 : 130) },
    bg: { L: .96, C: .02, h: 90 }, surface: { L: .92, C: .03, h: 85 }, text: { L: .27, C: .03, h: 60 } }),
  Monochrome: ({ L, C, h }) => ({
    primary: { L: Math.min(L, .5), C, h }, accent: { L: .7, C: C * .7, h: wrap(h + 15) },
    bg: { L: .97, C: .008, h }, surface: { L: .93, C: .015, h }, text: { L: .22, C: .02, h } }),
  Neon: ({ L, C, h }) => ({
    primary: { L: .75, C: .25, h }, accent: { L: .8, C: .25, h: wrap(h + 150) },
    bg: { L: .15, C: .03, h }, surface: { L: .21, C: .05, h }, text: { L: .95, C: .01, h } }),
  Corporate: ({ L, C, h }) => ({
    primary: { L: Math.min(L, .5), C: Math.min(C, .14), h }, accent: { L: .6, C: .08, h: wrap(h + 25) },
    bg: { L: .98, C: .005, h: 250 }, surface: { L: .95, C: .01, h: 250 }, text: { L: .25, C: .03, h: 250 } }),
  Vintage: ({ L, C, h }) => ({
    primary: { L: Math.min(L, .48), C: Math.min(C, .09), h }, accent: { L: .65, C: .09, h: wrap(h + 150) },
    bg: { L: .94, C: .03, h: 85 }, surface: { L: .89, C: .04, h: 80 }, text: { L: .3, C: .04, h: 50 } }),
  "High contrast": ({ L, C, h }) => ({
    primary: { L: Math.min(L, .38), C, h }, accent: { L: .55, C: .2, h: wrap(h + 180) },
    bg: { L: 1, C: 0, h }, surface: { L: .95, C: 0, h }, text: { L: 0, C: 0, h } }),
};

// ---- UI ----
const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
let mode = "Calm";
$("pm-modes").innerHTML = Object.keys(recipes).map(m => `<button data-recipe="${m}" aria-pressed="${m === mode}">${m}</button>`).join("");

function render() {
  const base = hexToOklch($<HTMLInputElement>("pm-hex").value);
  const p: Record<string, string> = Object.fromEntries(Object.entries(recipes[mode](base)).map(([k, v]) => [k, oklchToHex(v)]));
  p.onPrimary = onColour(p.primary); p.onAccent = onColour(p.accent);
  show(p);
}
let cur: Record<string, string>;
function show(p: Record<string, string>) {
  cur = p;
  for (const [k, v] of Object.entries(p)) $("pm-ui").style.setProperty("--" + k, v);
  $("pm-swatches").innerHTML = ["primary", "accent", "bg", "surface", "text"].map(k =>
    `<div data-hex="${p[k]}" title="Use as base colour" style="background:${p[k]};color:${onColour(p[k])}"><b>${k}</b>${p[k].toUpperCase()}</div>`).join("");
  const chk = (n: string, a: string, b: string) => { const r = contrast(a, b); return `${n} ${r.toFixed(1)}:1 ${r >= 4.5 ? "✓" : "✗"}`; };
  $("pm-checks").textContent = "Contrast (WCAG AA ≥ 4.5): " + [chk("text/bg", p.text, p.bg), chk("text/surface", p.text, p.surface), chk("button text", p.onPrimary, p.primary), chk("primary/bg", p.primary, p.bg)].join(" · ");
  document.querySelectorAll<HTMLElement>("#pm-modes [data-recipe]").forEach(b => b.setAttribute("aria-pressed", String(b.dataset.recipe === mode)));
}
$("pm-copy").onclick = async () => {
  const css = ":root {\n" + ["primary", "accent", "bg", "surface", "text", "onPrimary", "onAccent"].map(k => `  --${k}: ${$("pm-ui").style.getPropertyValue("--" + k)};`).join("\n") + "\n}";
  try { await navigator.clipboard.writeText(css); $("pm-copy").textContent = "Copied ✓"; }
  catch { prompt("Copy:", css); }
  setTimeout(() => ($("pm-copy").textContent = "Copy CSS variables"), 1500);
};
$("pm-swatches").onclick = e => {
  const s = (e.target as Element).closest<HTMLElement>("[data-hex]"); if (!s) return;
  $<HTMLInputElement>("pm-hex").value = $<HTMLInputElement>("pm-pick").value = s.dataset.hex!; render();
};

// ---- saved palettes (localStorage; per-browser only) ----
type Saved = { name: string; mode: string; base: string; p: Record<string, string> };
let saved: Saved[] = [];
try { saved = JSON.parse(localStorage.getItem("pm-palettes") || "[]"); } catch {}
const persist = () => { try { localStorage.setItem("pm-palettes", JSON.stringify(saved)); } catch {} };
function renderSaved() {
  $("pm-saved").innerHTML = saved.map((s, i) => `
    <div data-i="${i}">
      <div class="pm-strip">${["primary", "accent", "bg", "surface", "text"].map(k => `<span style="flex:1;background:${s.p[k]}"></span>`).join("")}</div>
      <div class="pm-row"><span><b></b> <small>${s.mode}</small></span><button data-del="${i}" aria-label="Delete">✕</button></div>
    </div>`).join("") || '<p class="pm-empty">Nothing saved yet.</p>';
  $("pm-saved").querySelectorAll("b").forEach((el, i) => (el.textContent = saved[i].name)); // textContent: names are user input
}
$("pm-saveForm").onsubmit = e => {
  e.preventDefault();
  saved.push({ name: $<HTMLInputElement>("pm-name").value.trim(), mode, base: $<HTMLInputElement>("pm-hex").value, p: cur });
  persist(); renderSaved(); $<HTMLInputElement>("pm-name").value = "";
};
$("pm-saved").onclick = e => {
  const del = (e.target as HTMLElement).dataset?.del;
  if (del !== undefined) { saved.splice(Number(del), 1); persist(); return renderSaved(); }
  const c = (e.target as Element).closest<HTMLElement>("[data-i]"); if (!c) return;
  const s = saved[Number(c.dataset.i)];
  mode = s.mode; $<HTMLInputElement>("pm-hex").value = $<HTMLInputElement>("pm-pick").value = s.base; show(s.p);
};
renderSaved();
$("pm-modes").onclick = e => { const m = (e.target as HTMLElement).dataset?.recipe; if (m) { mode = m; render(); } };
$<HTMLInputElement>("pm-pick").oninput = e => { $<HTMLInputElement>("pm-hex").value = (e.target as HTMLInputElement).value; render(); };
$<HTMLInputElement>("pm-hex").oninput = e => { if (/^#[0-9a-f]{6}$/i.test((e.target as HTMLInputElement).value)) { $<HTMLInputElement>("pm-pick").value = (e.target as HTMLInputElement).value; render(); } };
render();
</script>
