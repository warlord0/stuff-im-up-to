{n:'FROSTBITTEN · Frozen Teal',d:'Quiet and atmospheric: almost-black blue-green through deep teal to icy highlights. Keep the palest colours for text and light surfaces, like light through frost.',
 sw:[['Night Fjord','#0B1F24'],['Dark card','#102B31'],['Deep Teal','#1E4D57'],['Dark border','#2F5960'],['Glacier Teal','#2F7A80'],['Ice Glow','#8FC9CC'],['Frozen Mist','#D6ECEE'],['Snow Light','#E8F4F5'],['Storm Slate','#3A4A52'],['Light border','#B5D6D9'],['Light muted text','#3A6870']],
 dark:['#0B1F24','#102B31','#1E4D57','#2F5960','#E8F4F5','#8FC9CC','#8FC9CC','#0B1F24','#8FC9CC','#8FC9CC','#8FC9CC'],
 light:['#E8F4F5','#FFFFFF','#D6ECEE','#B5D6D9','#0B1F24','#3A6870','#2F7A80','#FFFFFF','#2F7A80','#1E4D57','#1E4D57']}
];
const K = ["bg", "s", "r", "bd", "t", "m", "a", "on", "ok", "warn", "bad"];
const vars = (t: string[]) => {
  const v: Record<string, string> = Object.fromEntries(K.map((k, i) => [k, t[i]]));
  v.m = v.m || `color-mix(in srgb,${v.t} 60%,${v.bg})`;
  return K.map(k => `--${k}:${v[k]}`).join(";");
};
const rows = [
  ["◉", "Network", "All connections stable", "ok"],
  ["◆", "Security", "Front door sensor open", "bad"],
  ["◐", "Climate", "Heating on schedule", "warn"],
];
---
<div class="pal not-prose">
  {P.map((p, i) => (
    <section data-mode="dark">
      <div class="bar">
        <h2 class="app-heading">{i + 1}. {p.n}</h2>
        {p.light ? (
          <div class="seg">
            <button class="on" data-m="dark">Dark</button><button data-m="light">Light</button>
          </div>
        ) : <span class="tag">Dark only</span>}
      </div>
      <div class="tag">{p.d}</div>
      {(["dark", "light"] as const).filter(m => p[m]).map(m => (
        <div class={`ui ${m}`} style={vars(p[m])}>
          <div>
            <div class="eyebrow">CONTROL SYSTEM / ONLINE</div>
            <div class="ttl">Good afternoon.</div>
            <div class="m">Your home, at a glance.</div>
          </div>
          <div class="g">
            <div class="c"><span class="m">System health</span><b>98.6%</b><div class="trk"><i></i></div></div>
            <div class="c"><span class="m">Living room</span><b>21.5°</b><span style="color:var(--warn)">Comfortable</span></div>
          </div>
          <div class="c">
            {rows.map(([ic, a, b, c]) => (
              <div class="row">
                <div class="ic">{ic}</div>
                <div><div>{a}</div><div class="m">{b}</div></div>
                <span class="dot" style={`background:var(--${c})`}></span>
              </div>
            ))}
          </div>
          <div class="btns"><span class="p">Overview</span><span class="q">Settings</span></div>
        </div>
      ))}
      <div class="sw">
        {p.sw.map(([n, h]: string[]) => <div><i style={`background:${h}`}></i>{n}<br /><code>{h}</code></div>)}
      </div>
    </section>
  ))}
</div>
<style>
.pal{display:grid;gap:3rem;margin:2rem 0;color:var(--foreground)}
.tag{color:var(--muted-foreground);font-size:.85rem;margin:.1rem 0 .75rem}
.bar{display:flex;gap:.5rem;margin-bottom:.25rem;align-items:center;justify-content:space-between;flex-wrap:wrap}
.bar h2{margin:0}
.seg button{background:none;border:1px solid var(--border);color:var(--muted-foreground);padding:.2rem .9rem;cursor:pointer;font:inherit}
.seg button:first-child{border-radius:99px 0 0 99px}.seg button:last-child{border-radius:0 99px 99px 0}
.seg button.on{background:var(--accent);border-color:var(--accent);color:var(--accent-foreground)}
section[data-mode="dark"] .light,section[data-mode="light"] .dark{display:none}
.ui{border-radius:16px;padding:16px;display:grid;gap:12px;border:1px solid var(--bd);background:var(--bg);color:var(--t)}
.eyebrow{font-size:11px;letter-spacing:.08em;color:var(--a)}
.ttl{font-size:24px;font-weight:600;line-height:1.2}.m{color:var(--m)}
.g{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.c{background:var(--s);border:1px solid var(--bd);border-radius:12px;padding:12px;display:grid;gap:6px}
.c b{font-size:24px}.trk{height:5px;border-radius:9px;background:var(--r)}.trk i{display:block;height:100%;width:76%;border-radius:9px;background:var(--a)}
.row{display:flex;align-items:center;gap:10px}.dot{width:8px;height:8px;border-radius:9px;margin-left:auto}
.ic{width:36px;height:36px;border-radius:10px;background:var(--r);display:grid;place-items:center;color:var(--a)}
.btns{display:flex;gap:8px}.btns span{flex:1;text-align:center;padding:10px;border-radius:10px;font-weight:500}
.p{background:var(--a);color:var(--on)}.q{background:var(--s);border:1px solid var(--bd)}
.sw{display:grid;grid-template-columns:repeat(auto-fill,minmax(100px,1fr));gap:8px;margin-top:12px}
.sw div{font-size:12px}.sw i{display:block;height:40px;border-radius:8px;border:1px solid var(--border);margin-bottom:4px}.sw code{color:var(--muted-foreground)}
</style>
<script>
  document.addEventListener("click", e => {
    const b = (e.target as Element).closest<HTMLElement>("[data-m]");
    if (!b) return;
    const s = b.closest("section")!;
    s.dataset.mode = b.dataset.m;
    s.querySelectorAll("[data-m]").forEach(x => x.classList.toggle("on", x === b));
  });
</script>
